# Bore & Barrel — Environment Variables
# Copy this file to .env and fill in the values.

# Base URL of the REST backend.
# This project uses a Supabase project (PostgREST at /rest/v1, Storage at
# /storage/v1). The university lab server https://modlima.fuadfakhruz.id is
# the alternative backend; src/config/api.js handles both.
# Set this in Vercel Project Settings > Environment Variables for production.
VITE_API_BASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key — sent as the `apikey` header and as a
# Bearer token by src/config/api.js. Leave empty for a non-Supabase backend.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx
